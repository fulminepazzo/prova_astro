---
const { title = 'Astro Basics' } = Astro.props;
import '../styles/global.css';
import background from '../assets/background.svg';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fira+Code&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body class="page-wrapper">
		<img id="global-background" src={background.src} alt="" fetchpriority="high" />
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<header class="header">
			<div class="navbar">
				<div class="logo">Astro</div>
				<nav class="nav-links">
					<a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
					<a href="/about/" aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined}>About</a>
					<a href="/blog/" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>Blog</a>
					<a href="/subscribe/" aria-current={Astro.url.pathname.startsWith('/subscribe') ? 'page' : undefined}>Subscribe</a>
				</nav>
			</div>
		</header>
		<main id="main-content" class="page-content">
			<slot />
		</main>
		<footer class="footer">
			<div class="footer-content">
				<div class="footer-section">
					<h3>Navigation</h3>
					<a href="/">Home</a>
					<a href="/about/">About</a>
					<a href="/blog/">Blog</a>
					<a href="/subscribe/">Subscribe</a>
				</div>
				<div class="footer-section">
					<h3>Resources</h3>
					<a href="https://docs.astro.build">Astro Documentation</a>
					<a href="https://astro.build/chat">Community Chat</a>
					<a href="https://github.com/withastro/astro">GitHub</a>
				</div>
			</div>
			<div class="footer-bottom">
				<p>&copy; {new Date().getFullYear()} Astro Project. All rights reserved.</p>
				<p>Built with <a href="https://astro.build">Astro</a></p>
			</div>
		</footer>
	</body>
</html>

<style>
	.page-wrapper {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		position: relative;
	}
	
	#global-background {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		filter: blur(100px);
	}
	
	.main-content {
		flex: 1;
	}
	
	html {
		scroll-behavior: smooth;
	}
	
	.logo {
		font-weight: 700;
		font-size: 1.5rem;
		color: var(--text-primary);
	}
	
	/* Ensure proper spacing */
	.nav-links {
		display: flex;
		gap: 1rem;
	}
	
	.footer-content {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 2rem;
	}
	
	.footer-section h3 {
		color: var(--text-inverse);
		font-size: 1.125rem;
		margin-bottom: 1rem;
	}
	
	.footer-section a {
		color: var(--color-neutral-400);
		display: block;
		margin-bottom: 0.5rem;
	}
	
	.footer-section a:hover {
		color: var(--text-inverse);
	}
	
	.footer-bottom {
		max-width: 1200px;
		margin: 2rem auto 0;
		padding: 0 2rem;
		border-top: 1px solid var(--border-dark);
		padding-top: 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.875rem;
		color: var(--color-neutral-500);
	}
	
	.footer-bottom p {
		margin: 0;
	}
	
	@media screen and (max-width: 767px) {
		.nav-links {
			flex-direction: column;
			gap: 0.5rem;
		}
		
		.footer-bottom {
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}
	}
</style>
