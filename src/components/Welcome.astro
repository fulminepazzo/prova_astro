---
import astroLogo from '../assets/astro.svg';
---

<div id="container">
	<main>
		<section id="hero">
			<a href="https://astro.build">
				<img src={astroLogo.src} width="115" height="48" alt="Astro Homepage" />
			</a>
			<h1>
				hola, To get started, open the <code><pre>src/pages</pre></code> directory in your project.
			</h1>
			<section id="links">
				<a href="https://docs.astro.build" class="button">
					Read our docs
				</a>
				<a href="https://astro.build/chat" class="button button-outline">
					Join our Discord
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 127.14 96.36">
						<path
							fill="currentColor"
							d="M107.7 8.07A105.15 105.15 0 0 0 81.47 0a72.06 72.06 0 0 0-3.36 6.83 97.68 97.68 0 0 0-29.11 0A72.37 72.37 0 0 0 45.64 0a105.89 105.89 0 0 0-26.25 8.09C2.79 32.65-1.71 56.6.54 80.21a105.73 105.73 0 0 0 32.17 16.15 77.7 77.7 0 0 0 6.89-11.11 68.42 68.42 0 0 1-10.85-5.18c.91-.66 1.8-1.34 2.66-2a75.57 75.57 0 0 0 64.32 0c.87.71 1.76 1.39 2.66 2a68.68 68.68 0 0 1-10.87 5.19 77 77 0 0 0 6.89 11.1 105.25 105.25 0 0 0 32.19-16.14c2.64-27.38-4.51-51.11-18.9-72.15ZM42.45 65.69C36.18 65.69 31 60 31 53s5-12.74 11.43-12.74S54 46 53.89 53s-5.05 12.69-11.44 12.69Zm42.24 0C78.41 65.69 73.25 60 73.25 53s5-12.74 11.44-12.74S96.23 46 96.12 53s-5.04 12.69-11.43 12.69Z"
						></path>
					</svg>
				</a>
			</section>
		</section>
	</main>

	<a href="https://astro.build/blog/astro-7/" id="news" class="card news-card">
		<div class="card-content">
			<svg width="32" height="32" fill="none" xmlns="http://www.w3.org/2000/svg" class="news-icon">
				<path
					d="M24.667 12c1.333 1.414 2 3.192 2 5.334 0 4.62-4.934 5.7-7.334 12C18.444 28.567 18 27.456 18 26c0-4.642 6.667-7.053 6.667-14Zm-5.334-5.333c1.6 1.65 2.4 3.43 2.4 5.333 0 6.602-8.06 7.59-6.4 17.334C13.111 27.787 12 25.564 12 22.666c0-4.434 7.333-8 7.333-16Zm-6-5.333C15.111 3.555 16 5.556 16 7.333c0 8.333-11.333 10.962-5.333 22-3.488-.774-6-4-6-8 0-8.667 8.666-10 8.666-20Z"
					fill="currentColor"
				></path>
			</svg>
			<h2>What's New in Astro 7.0?</h2>
			<p>
				Rust-powered compiler, advanced routing, AI agent support, and more! Click to explore Astro
				7.0's new features.
			</p>
		</div>
	</a>
</div>

<style>
	#container {
		font-family: var(--font-family-sans);
		height: 100%;
		position: relative;
	}

	main {
		height: 100%;
		display: flex;
		justify-content: center;
	}

	#hero {
		display: flex;
		align-items: start;
		flex-direction: column;
		justify-content: center;
		padding: 1rem;
	}

	h1 {
		font-size: 1.375rem;
		margin-top: 0.25em;
		color: var(--text-primary);
		line-height: 1.6;
	}

	#links {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	#links a {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
	}

	#links a svg {
		height: 1em;
	}

	code pre {
		font-family: var(--font-family-mono);
		font-weight: normal;
		background: linear-gradient(14deg, #d83333 0%, #f041ff 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin: 0;
		display: inline;
		line-height: 1;
		vertical-align: baseline;
		padding: 0;
	}

	.code {
		display: inline-block;
		background: var(--color-primary-100);
		color: var(--color-primary-700);
		border-radius: var(--radius-sm);
		border: 1px solid var(--color-primary-200);
		padding: 0.25rem 0.375rem;
		font-family: var(--font-family-mono);
		font-size: 0.875rem;
		vertical-align: baseline;
		line-height: 1;
	}

	.card-content {
		padding: 1.5rem;
		height: 100%;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.news-card {
		padding: 0;
		text-align: left;
		transition: all var(--transition-normal);
		max-width: 300px;
	}

	.news-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-lg);
	}

	.news-icon {
		color: var(--color-primary-600);
		flex-shrink: 0;
	}

	.news-card h2 {
		margin: 0;
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-semibold);
		color: var(--text-primary);
	}

	.news-card p {
		margin: 0;
		color: var(--text-secondary);
		line-height: 1.6;
		flex: 1;
	}

	#news {
		position: absolute;
		bottom: 1rem;
		right: 1rem;
		text-decoration: none;
		color: var(--text-primary);
	}

	@media screen and (max-height: 368px) {
		#news {
			display: none;
		}
	}

	@media screen and (max-width: 768px) {
		#container {
			display: flex;
			flex-direction: column;
		}

		#hero {
			display: block;
			padding-top: 10%;
		}

		#links {
			flex-wrap: wrap;
			justify-content: center;
		}

		#links .button {
			padding: 0.875rem 1.5rem;
			font-size: var(--font-size-base);
		}

		.news-card {
			right: 1rem;
			left: 1rem;
			bottom: 2.5rem;
			max-width: 100%;
		}

		h1 {
			line-height: 1.5;
			text-align: center;
		}
	}
</style>
